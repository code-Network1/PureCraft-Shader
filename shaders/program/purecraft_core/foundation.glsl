            // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
            // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
            float globalWetness = distMask * rainFactor * 0.85;
            
            // Dampen terrain color generically everywhere it rains
            color.rgb *= mix(1.0, 0.65, globalWetness);
            
            // Add a soft global gloss to the entire terrain
            smoothnessG = mix(smoothnessG, max(smoothnessG, 0.65), globalWetness);
            
            // Add slight weak reflections (restored at all times)
            smoothnessD = mix(smoothnessD, max(smoothnessD, 0.4), globalWetness);
            
            vec3 worldPos = playerPos + cameraPosition;
            float timeAnim = frameTimeCounter * 0.5;
            vec3 move1 = vec3(sin(timeAnim), 0.0, cos(timeAnim)) * 1.5;
            vec3 move2 = vec3(cos(timeAnim * 0.8), 0.0, -sin(timeAnim * 0.8)) * 1.2;
            
            // 1. Generation of diverse noise frequencies
            mat2 rot = mat2(0.737, -0.675, 0.675, 0.737); 
            
            // Different spatial scales
            vec2 cMid   = worldPos.xz * 0.035;
            vec2 cFine  = rot * (worldPos.xz * 0.061 + vec2(15.3, 8.4));
            vec2 cMacro = worldPos.xz * 0.012; // Modifiers
            vec2 cReg   = worldPos.xz * 0.003; // Enormous map zones (biomes)
            
            float nMid   = texture2D(noisetex, cMid).b;
            float nFine  = texture2D(noisetex, cFine).b;
            float macro  = texture2D(noisetex, cMacro).b;
            float region = texture2D(noisetex, cReg).b; // determines the 'style' of the area
            
            float baseMix = (nMid + nFine) * 0.5;
            
            // 2. Creating DIFFERENT Puddle Structural Styles
            // Style A: Massive organic smooth lakes
            float styleA = smoothstep(0.20, 0.50, baseMix * macro * 1.6);
            
            // Style B: Huge muddy rivers and wide streams
            float vein = 1.0 - abs(baseMix * 2.0 - 1.0); 
            float styleB = smoothstep(0.70, 0.90, vein * macro * 1.3);
            
            // Style C: Larger grouped fields of heavy droplets
            float styleC = smoothstep(0.50, 0.75, nFine) * smoothstep(0.2, 0.6, macro);
            
            // 3. Assigning Styles to World Regions
            // Extended thresholds to massively increase puddle density and coverage globally
            float maskA = smoothstep(0.1, 0.6, region);               
            float maskB = smoothstep(0.3, 0.8, 1.0 - region);         
            float maskC = smoothstep(0.6, 0.95, abs(region * 2.0 - 1.0)); 
            
            // Blend the puddle shapes dynamically based on the region
            float puddleMask = (styleA * maskA) + (styleB * maskB) + (styleC * maskC);
            puddleMask = clamp(puddleMask, 0.0, 1.0);
            
            // 4. Moving flow noise to animate the surface of the water without moving the shapes
            vec2 flowCoord1 = (worldPos.xz + move1.xz * 0.6) * 0.15;
            vec2 flowCoord2 = (worldPos.xz + move2.xz * 0.6) * 0.20;
            float f1 = texture2D(noisetex, flowCoord1).b;
            float f2 = texture2D(noisetex, flowCoord2).b;
            float flowAnim = (f1 + f2) * 0.5;
            
            // Combine: Water exists in static shapes, but ripples inside dynamically
            float finalWater = puddleMask * (0.5 + 0.5 * flowAnim);
            
            float mistOpacity = distMask * finalWater * rainFactor;
            mistOpacity = clamp(mistOpacity, 0.0, 0.85);
            
            if (mistOpacity > 0.0) {
                // Lighten the wet terrain darkening so it does not look like black sludge
                vec3 wetTerrain = color.rgb * 0.85; 
                
                // Set the base color (pure wet terrain). SSR will naturally add sky, sun, and house reflections on top!
                color.rgb = mix(color.rgb, wetTerrain, mistOpacity);
                
                // Native Hardware SSR Injection
                smoothnessD = mix(smoothnessD, 1.0, mistOpacity); // Pure mirror
                smoothnessG = mix(smoothnessG, 1.0, mistOpacity); 
                materialMask = mix(materialMask, 1.0 / 255.0, mistOpacity); // Intense Fresnel ID
                
                // Correctly anchor the ripples to the physical 3D world (World Space -> View Space)
                // This prevents the reflection from warping when moving the mouse/camera!
                vec3 worldRippleNormal = vec3((f1 - f2) * 0.08, 1.0, (f1 * f2) * 0.08);
                vec3 viewRippleNormal = normalize(mat3(gbufferModelView) * worldRippleNormal);
                normalM = mix(normalM, viewRippleNormal, mistOpacity);
            }
        }
    }

